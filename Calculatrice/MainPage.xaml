<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Calculatrice.MainPage"
             Title="Calculatrice"
             BackgroundColor="#0F172A"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>

        <!-- Définition de la palette de couleur de ma calculatrice -->

        <Color x:Key="PageBackground">#0B1120</Color>
        <Color x:Key="DisplayBackground">#172033</Color>
        <Color x:Key="DisplayStroke">#2A3852</Color>

        <Color x:Key="TextPrimary">#F8FAFC</Color>
        <Color x:Key="TextSecondary">#94A3B8</Color>
        <Color x:Key="DarkText">#0B1120</Color>

        <Color x:Key="NumberColor">#26344A</Color>
        <Color x:Key="FunctionColor">#4F46E5</Color>
        <Color x:Key="OperatorColor">#7C3AED</Color>
        <Color x:Key="EqualsColor">#06B6D4</Color>

        <!-- Couleurs au survol de la souris (Hover) et pendant le clic (Pressed) -->
        <Color x:Key="NumberHover">#344765</Color>
        <Color x:Key="NumberPressed">#1A2332</Color>
        <Color x:Key="FunctionHover">#716AEA</Color>
        <Color x:Key="FunctionPressed">#3127E1</Color>
        <Color x:Key="OperatorHover">#955FF0</Color>
        <Color x:Key="OperatorPressed">#6619EA</Color>
        <Color x:Key="EqualsHover">#0BD6F8</Color>
        <Color x:Key="EqualsPressed">#0598B1</Color>

        <!-- Style commun aux touches du clavier -->
        <Style x:Key="KeyBase" TargetType="Button">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- style pour chaque touche (avec 3 états : Normal, PointerOver = survol souris, Pressed = clic) -->
        <Style x:Key="NumberKey" TargetType="Button" BasedOn="{StaticResource KeyBase}">
            <Setter Property="BackgroundColor" Value="{StaticResource NumberColor}" />
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource NumberColor}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource NumberHover}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource NumberPressed}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="FunctionKey" TargetType="Button" BasedOn="{StaticResource KeyBase}">
            <Setter Property="BackgroundColor" Value="{StaticResource FunctionColor}" />
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource FunctionColor}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource FunctionHover}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource FunctionPressed}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="OperatorKey" TargetType="Button" BasedOn="{StaticResource KeyBase}">
            <Setter Property="BackgroundColor" Value="{StaticResource OperatorColor}" />
            <Setter Property="TextColor" Value="{StaticResource DarkText}" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource OperatorColor}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource OperatorHover}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource OperatorPressed}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="EqualsKey" TargetType="Button" BasedOn="{StaticResource KeyBase}">
            <Setter Property="BackgroundColor" Value="{StaticResource EqualsColor}" />
            <Setter Property="TextColor" Value="{StaticResource DarkText}" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource EqualsColor}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource EqualsHover}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource EqualsPressed}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <!-- Le Layout racine est un Grid de 3 lignes (la barre, l'affichage, le clavier) -->
    <Grid Padding="12" RowSpacing="10" RowDefinitions="Auto,Auto,*">

        <!-- La ligne 0 correspond à la barre d'information qui est HorizontalStackLayout -->
        <HorizontalStackLayout Grid.Row="0" Spacing="8">
            <Label Text="Opérateur en cours :"
                   TextColor="{StaticResource TextSecondary}"
                   FontSize="14"
                   VerticalOptions="Center" />
            <Label x:Name="OperatorLabel"
                   Text="—"
                   TextColor="{StaticResource OperatorColor}"
                   FontSize="20"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- La ligne 1 correspond à la  zone d'affichage encadree par un Border et un VerticalStackLayout -->
        <Border Grid.Row="1"
                Padding="16"
                BackgroundColor="{StaticResource DisplayBackground}"
                Stroke="{StaticResource DisplayStroke}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16">
            <VerticalStackLayout Spacing="4">
                <Label x:Name="OperationLabel"
                       Text=""
                       MinimumHeightRequest="26"
                       FontSize="18"
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalTextAlignment="End"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />
                <Label x:Name="ResultLabel"
                       Text="0"
                       FontSize="40"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       HorizontalTextAlignment="End"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />
            </VerticalStackLayout>
        </Border>

        <!-- La ligne 2 correspond au clavier qui est une Grid de 5 lignes et 4 colonnes) -->
        <Grid Grid.Row="2"
              RowSpacing="8"
              ColumnSpacing="8"
              RowDefinitions="*,*,*,*,*"
              ColumnDefinitions="*,*,*,*">

            <!-- Rangée 0 : AC  *  %  ÷ -->
            <Button Grid.Row="0" Grid.Column="0" Text="AC" Style="{StaticResource FunctionKey}" Clicked="OnClearClicked" />
            <Button Grid.Row="0" Grid.Column="1" Text="*" Style="{StaticResource FunctionKey}" Clicked="OnBackspaceClicked" />
            <Button Grid.Row="0" Grid.Column="2" Text="%" Style="{StaticResource FunctionKey}" Clicked="OnOperatorClicked" />
            <Button Grid.Row="0" Grid.Column="3" Text="÷" Style="{StaticResource OperatorKey}" Clicked="OnOperatorClicked" />

            <!-- Rangée 1 : 7  8  9  × -->
            <Button Grid.Row="1" Grid.Column="0" Text="7" Style="{StaticResource NumberKey}" Clicked="OnDigitClicked" />
            <Button Grid.Row="1" Grid.Column="1" Text="8" Style="{StaticResource NumberKey}" Clicked="OnDigitClicked" />
            <Button Grid.Row="1" Grid.Column="2" Text="9" Style="{StaticResource NumberKey}" Clicked="OnDigitClicked" />
            <Button Grid.Row="1" Grid.Column="3" Text="×" Style="{StaticResource OperatorKey}" Clicked="OnOperatorClicked" />

            <!-- Rangée 2 : 4  5  6  − -->
            <Button Grid.Row="2" Grid.Column="0" Text="4" Style="{StaticResource NumberKey}" Clicked="OnDigitClicked" />
            <Button Grid.Row="2" Grid.Column="1" Text="5" Style="{StaticResource NumberKey}" Clicked="OnDigitClicked" />
            <Button Grid.Row="2" Grid.Column="2" Text="6" Style="{StaticResource NumberKey}" Clicked="OnDigitClicked" />
            <Button Grid.Row="2" Grid.Column="3" Text="−" Style="{StaticResource OperatorKey}" Clicked="OnOperatorClicked" />

            <!-- Rangée 3 : 1  2  3  + -->
            <Button Grid.Row="3" Grid.Column="0" Text="1" Style="{StaticResource NumberKey}" Clicked="OnDigitClicked" />
            <Button Grid.Row="3" Grid.Column="1" Text="2" Style="{StaticResource NumberKey}" Clicked="OnDigitClicked" />
            <Button Grid.Row="3" Grid.Column="2" Text="3" Style="{StaticResource NumberKey}" Clicked="OnDigitClicked" />
            <Button Grid.Row="3" Grid.Column="3" Text="+" Style="{StaticResource OperatorKey}" Clicked="OnOperatorClicked" />

            <!-- Rangée 4 : ±  0  .  = -->
            <Button Grid.Row="4" Grid.Column="0" Text="±" Style="{StaticResource FunctionKey}" Clicked="OnSignClicked" />
            <Button Grid.Row="4" Grid.Column="1" Text="0" Style="{StaticResource NumberKey}" Clicked="OnDigitClicked" />
            <Button Grid.Row="4" Grid.Column="2" Text="." Style="{StaticResource NumberKey}" Clicked="OnDecimalClicked" />
            <Button Grid.Row="4" Grid.Column="3" Text="=" Style="{StaticResource EqualsKey}" Clicked="OnEqualsClicked" />
        </Grid>
    </Grid>
</ContentPage>
 